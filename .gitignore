# This repo only tracks Code/web/ — the Vercel-deployable web app.
# Everything else stays on local disk but is ignored by git.

# --- Ignore everything outside Code/web/ ---
/*
!/.gitignore
!/Code/
/Code/*
!/Code/web/

# Python conversion script lives next to the web app for convenience but
# isn't part of the Vercel build.
/Code/web/scripts/

# --- Node ---
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- TypeScript build artifacts ---
*.tsbuildinfo
Code/web/vite.config.js
Code/web/vite.config.d.ts

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Vercel ---
.vercel

# --- Environment ---
.env
.env.local
.env.*.local
